# Application listener; supplied Compose uses APP_PORT and fixes HOST instead
PORT=3000
HOST=0.0.0.0
# Optional comma-separated trusted proxy IPs/CIDRs; empty disables proxy trust
TRUST_PROXY=
# Supplied Compose fixes DATABASE_PATH to /app/data/monitor.sqlite
DATABASE_PATH=./data/monitor.sqlite
# Relative to the working directory; not forwarded by supplied Compose
EXTENSION_DIRECTORY=./extension
APP_TIME_ZONE=Europe/Warsaw
# Default 5; effective minimum 2
LISTING_RETENTION_CHECKS=5
# Public HTTPS origin used by the downloaded extension, without a path
APP_PUBLIC_URL=
TELEGRAM_BOT_TOKEN=
# Comma-separated recipients; Telegram is optional
TELEGRAM_CHAT_IDS=
# Legacy fallback, used only when TELEGRAM_CHAT_IDS is unset or empty
TELEGRAM_CHAT_ID=
# Panel login and persistent session signing
APP_USERNAME=
APP_PASSWORD=
# At least 32 random characters; changing it logs out every browser
APP_SESSION_SECRET=

# Compose only; not read by the application
APP_PORT=3000
BIND_ADDRESS=0.0.0.0
IMAGE_TAG=latest
