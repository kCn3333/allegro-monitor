PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/monitor.sqlite
EXTENSION_ZIP_PATH=./extension.zip
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Panel login and persistent session signing
APP_USERNAME=
APP_PASSWORD=
# At least 32 random characters; changing it logs out every browser
APP_SESSION_SECRET=

# Legacy Allegro sandbox API helper (allegro_auth.py)
ALLEGRO_CLIENT_ID=your_client_id_here
ALLEGRO_CLIENT_SECRET=your_client_secret_here
ALLEGRO_TOKEN_URL=https://allegro.pl.allegrosandbox.pl/auth/oauth/token
ALLEGRO_CATEGORIES_URL=https://api.allegro.pl.allegrosandbox.pl/sale/categories
# Set to "false" to disable SSL verification (NOT RECOMMENDED)
ALLEGRO_SSL_VERIFY=true
