{
  "all": true,
  "src": [
    "src"
  ],
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "test/**",
    "node_modules/**",
    "dist/**",
    "src/types.ts"
  ],
  "extension": [
    ".ts"
  ],
  "exclude-after-remap": true,
  "reporter": [
    "text",
    "html",
    "lcovonly"
  ],
  "reports-dir": "coverage"
}
