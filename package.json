{
  "name": "allegro-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/src/server.js",
    "test": "node --experimental-sqlite --import tsx --test test/**/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "fastify": "^5.5.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.5"
  }
}
