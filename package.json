{
  "name": "allegro-monitor",
  "version": "1.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/src/main.js",
    "test": "node --experimental-sqlite --import tsx --test test/**/*.test.ts",
    "test:browser": "node --experimental-sqlite --import tsx --test test/browser/*.browser.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "playwright": "1.65.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.5"
  }
}
