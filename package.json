{
  "name": "allegro-monitor",
  "version": "1.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/src/main.js",
    "test": "node --experimental-sqlite --import tsx --test test/**/*.test.ts",
    "test:coverage": "c8 npm test",
    "test:browser": "node --experimental-sqlite --import tsx --test test/browser/*.browser.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "format": "biome format --write src test public extension",
    "format:check": "biome format src test public extension",
    "lint": "biome lint src test public extension"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "ajv": "8.20.0",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^22.18.6",
    "c8": "^12.0.0",
    "playwright": "1.65.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "overrides": {
    "c8": {
      "test-exclude": {
        "glob": "^14.0.6",
        "minimatch": "^11.0.8"
      }
    }
  }
}
