{
  "manifest_version": 3,
  "name": "Allegro Monitor Companion",
  "version": "1.2.0",
  "description": "Monitoruje otwarte wyszukiwania Allegro i przekazuje nowe oferty do prywatnego serwera.",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://allegro.pl/*",
    "https://*.allegro.pl/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Allegro Monitor",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  }
}
